# The image catalogues published onto the site, one per line. Each is a release
# tagged catalogue-<name> in the images repo, and lands at /builds/<name>/.
#
# Every deploy rebuilds the site from scratch, so this list is the whole of what
# the site offers: a catalogue dropped from here disappears from it at the next
# deploy, and flashmon's Build selector stops listing it. Removing a name
# does not touch the release it came from.
#
# `stable` is what flashmon serves when nothing says otherwise.
stable
dev
